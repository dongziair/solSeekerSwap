# 钱包私钥（base58 格式）
PRIVATE_KEY=your_base58_private_key_here

# Solana RPC 节点地址
RPC_URL=https://api.mainnet-beta.solana.com

# ==================== DFlow 配置 ====================
# DFlow API Key（可选，不填则使用开发环境）
DFLOW_API_KEY=

# ==================== OKX DEX 配置 ====================
# OKX DEX API 凭证（从 https://www.okx.com/web3/build/dev-portal 获取）
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROJECT_ID=

# ==================== Swap 参数 ====================
# 每日 swap 次数范围
DAILY_SWAP_MIN=100
DAILY_SWAP_MAX=150

# 每次 swap 金额范围（SOL 单位）
SWAP_AMOUNT_SOL_MIN=0.001
SWAP_AMOUNT_SOL_MAX=0.005
